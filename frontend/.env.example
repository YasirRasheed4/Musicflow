# Leave empty when frontend and backend are deployed together on Vercel.
# Set this only when the Node API is hosted at a different public URL.
VITE_API_URL=

# Supabase Auth (the anon/publishable key is safe to expose in the browser).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
