NODE_ENV=production
PORT=4000
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=https://your-vercel-domain.example
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Supabase only: set true if its certificate chain fails verification in Vercel.
# This keeps TLS encryption but disables certificate identity verification.
# DATABASE_SSL_NO_VERIFY=true
# Set DB_CLIENT=sqlite for local development (requires Node.js 22+).
