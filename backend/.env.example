NODE_ENV=production
PORT=4000
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=https://your-infinityfree-domain.example
# Use the MySQL provider's connection URL when available.
# DATABASE_URL=mysql://user:password@host:3306/database
# Or provide the individual DB_* variables below instead.
DB_HOST=your-infinityfree-mysql-host
DB_PORT=3306
DB_NAME=your-infinityfree-database-name
DB_USER=your-infinityfree-database-user
DB_PASSWORD=your-infinityfree-database-password
# Set DB_CLIENT=sqlite for local development (requires Node.js 22+).